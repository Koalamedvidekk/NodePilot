{
  "name": "nodepilot-server",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "setup": "tsx setup.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.0.0",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.7",
    "openpgp": "^6.3.2",
    "prismarine-nbt": "^2.8.0",
    "tar": "^7.5.22",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
